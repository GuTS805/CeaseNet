# ---------- Test wallets (generated by `npm run keys`, testnet only) ----------
DEMO_MNEMONIC=""

# ---------- Arkiv ----------
# https://hub.arkiv.network/access-keys
# Optional. It has a quota, and when that runs out everything carries on through the public endpoint.
ARKIV_ACCESS_KEY=""

# ---------- AI model for the demo agents ----------
# Any service that speaks the OpenAI chat API and supports tool calling, including one you run yourself.
# Free key: https://console.groq.com/keys
MODEL_API_KEY=""
MODEL_API_URL="https://api.groq.com/openai/v1"
MODEL_NAME="openai/gpt-oss-20b"
# Shared by all the agents, so keep it under your key's limit. Check it with: npm run model-check
MODEL_REQUESTS_PER_MINUTE="16"
# Only for models that accept it, such as MODEL_REASONING_EFFORT="none"
MODEL_REASONING_EFFORT=""

# ---------- World ID: confirmations by real humans (IDKit) ----------
# https://developer.world.org
# Looks like app_xxxxx
WORLD_APP_ID=""
# Looks like rp_xxxxx
WORLD_RP_ID=""
# Secret
WORLD_RP_SIGNING_KEY=""
# staging works with the World ID simulator. Real people on phones need production and a matching action.
WORLD_ENVIRONMENT="staging"

# ---------- World ID: human behind an AI scanner (Agent Pass) ----------
# https://auth.world.org/portal, or https://sandbox.auth.world.org/portal for the sandbox
WORLD_IDP_ISSUER="https://auth.world.org"
WORLD_IDP_CLIENT_ID=""
# Secret, shown once, starts with worldidp_client_secret_
WORLD_IDP_CLIENT_SECRET=""

# ---------- Reports from people ----------
# How many different people must vote before an owner is told. Set this in ~/.ceasenet/.env, or import it.
REPORT_VOTES_NEEDED="3"
# The verifier whose reports you listen to. Empty means the one in deployment.json.
REPORT_VERIFIER=""

# ---------- The three trading agents ----------
# "compact" opens their windows small, in a column on the right of the screen, so all three and a browser fit on one
# screen for a recording. Windows only. Empty opens them as usual.
AGENT_TERMINALS=""

# ---------- Swarm ----------
# Your Bee node or upload service. Both are needed to upload.
BEE_API_URL=""
SWARM_POSTAGE_BATCH_ID=""
# Where browsers and agents read from when they have no node of their own
SWARM_GATEWAY_URL="https://api.gateway.ethswarm.org"
