{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @ceasenet/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/verifier.mjs": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/api/:route", "destination": "/api/verifier?route=:route" }]
}
