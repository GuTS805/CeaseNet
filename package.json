{
  "name": "ceasenet",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.10.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run build -w ceasenet",
    "product-check": "tsx scripts/product-check.ts",
    "agents-check": "tsx scripts/agents-check.ts",
    "records-check": "tsx scripts/records-check.ts",
    "fund-owner": "tsx --env-file=.env scripts/fund-owner.ts",
    "test": "vitest run",
    "test:design": "node scripts/design-check.mjs",
    "keys": "tsx scripts/keys.ts",
    "fund": "tsx --env-file=.env scripts/fund.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "friction": "tsx --env-file=.env scripts/friction.ts",
    "query": "tsx scripts/query.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "e2e": "tsx --env-file=.env scripts/e2e.ts",
    "reset": "tsx --env-file=.env scripts/reset.ts",
    "web": "npm run dev -w @ceasenet/web",
    "web:demo": "npm run dev -w @ceasenet/web -- --mode demo",
    "install-cli": "npm pack -w ceasenet && npm install -g ceasenet-0.1.0.tgz",
    "demo": "tsx --env-file=.env apps/demo/src/server.ts",
    "demo:dev": "tsx --env-file=.env scripts/demo-dev.ts",
    "fresh": "tsx --env-file=.env scripts/fresh.ts",
    "proxy-check": "tsx --env-file=.env scripts/proxy-check.ts",
    "verifier": "tsx --env-file=.env apps/verifier/src/server.ts",
    "diary-check": "tsx --env-file=.env scripts/diary-check.ts",
    "model-check": "tsx --env-file=.env scripts/model-check.ts",
    "swarm-check": "tsx --env-file=.env scripts/swarm-check.ts",
    "agent-pass-check": "tsx --env-file=.env scripts/agent-pass-check.ts",
    "local-bee": "tsx scripts/local-bee.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
