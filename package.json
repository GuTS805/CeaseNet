{
  "name": "ceasenet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.10.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "keys": "tsx scripts/keys.ts",
    "fund": "tsx --env-file=.env scripts/fund.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "e2e": "tsx --env-file=.env scripts/e2e.ts",
    "reset": "tsx --env-file=.env scripts/reset.ts",
    "web": "npm run dev -w @ceasenet/web",
    "demo": "tsx --env-file=.env apps/demo/src/server.ts",
    "demo:dev": "tsx --env-file=.env scripts/demo-dev.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
